root = true

[*] # Indicates all files apply
charset = utf-8 # Set file character encoding to utf-8
indent_style = space # Indentation style (tab | space)
indent_size = 2 # Indent size
end_of_line = lf # Control newline type (lf | cr | crlf)
trim_trailing_whitespace = true # Strip leading whitespace
insert_final_newline = true # Always insert a new line at the end of the file

[*.md] # Indicates the following rules apply only to md files
max_line_length = off # Disable max line length limit
trim_trailing_whitespace = false # Disable trailing whitespace trimming
